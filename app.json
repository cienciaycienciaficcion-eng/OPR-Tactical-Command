{
  "expo": {
    "name": "OPR Tactical Command",
    "slug": "opr-tactical-command",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/opr-tactical-command-icon.png",
    "scheme": "oprofflineapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/opr-tactical-command-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/opr-tactical-command-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oprtuc.tacticalcommand"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050608",
          "image": "./assets/images/opr-tactical-command-splash.png",
          "imageWidth": 300
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
